# Choose `ollama` for local generation or `openai` for a deployed backend.
AI_PROVIDER=ollama
# Ollama runs entirely on your computer. Pull the default model with:
# ollama pull llama3.1:8b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Required only when AI_PROVIDER=openai. Never commit this value.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=3001
